<?xml version="1.0" encoding="utf-8"?>
<!-- Menu chính: hiện sau khi kiểm tra tài nguyên xong (đã sẵn sàng).
     3 lựa chọn: Vào game / Sửa lỗi tài nguyên / Backup-Import data game.
     Nút Cập nhật app (otaApk) chỉ hiện khi có bản APK mới trên release. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E1412">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="32dp">

        <ImageView
            android:id="@+id/menuLogo"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:contentDescription="@string/app_name"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:id="@+id/menuTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Võ Lâm Idle"
            android:textColor="#E8D8A8"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/menuStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Tài nguyên — đã sẵn sàng"
            android:textColor="#CCCCCC"
            android:textSize="14sp" />

        <ProgressBar
            android:id="@+id/menuBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/menuPlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:minWidth="240dp"
            android:text="Vào Game" />

        <Button
            android:id="@+id/menuRepair"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:minWidth="240dp"
            android:text="Sửa lỗi tài nguyên" />

        <Button
            android:id="@+id/menuBackup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:minWidth="240dp"
            android:text="Backup / Import data game" />

        <Button
            android:id="@+id/otaApk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:minWidth="240dp"
            android:visibility="gone"
            android:text="Cập nhật app" />

        <TextView
            android:id="@+id/otaApkNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:maxLines="4"
            android:scrollbars="vertical"
            android:textColor="#9AA79B"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/versionCorner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:padding="14dp"
        android:textColor="#6E7A70"
        android:textSize="11sp" />
</FrameLayout>

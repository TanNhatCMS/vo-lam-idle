// Cloudflare Worker phuc vu ban web (Next.js static export) cua Vo Lam Idle.
// Assets = thu muc game/ (index.html + _next/ + media) — CUNG mot artifact ma
// app Android nhan qua OTA, nen web va app luon dong bo.
// Deploy: npx wrangler deploy   (can dang nhap Cloudflare: npx wrangler login)
{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "vo-lam-idle",
  "main": "chat-proxy.js",
  "compatibility_date": "2026-10-04",
  "workers_dev": true,
  "observability": { "enabled": false },
  "routes": [
    { "pattern": "vo-lam-idle.tannhatcms.io.vn", "custom_domain": true }
  ],
  "assets": {
    "directory": "game",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  // The Gioi multiplayer: Durable Object MpRoom (1 instance/room, SQLite) — xem chat-proxy.js
  "durable_objects": {
    "bindings": [{ "name": "MP_ROOM", "class_name": "MpRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MpRoom"] }]
}
